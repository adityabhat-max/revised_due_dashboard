# Copy this file to .env.local for local development, and set the same
# variables in your Vercel project's Environment Variables for
# production. Never commit real values — .env.local is gitignored.

# The Google Sheet ID (the long string in the sheet's URL between /d/ and /edit)
GOOGLE_SHEET_ID=

# The full contents of your Google service-account JSON key file, as one line
SERVICE_ACCOUNT_JSON=

# A JSON array of accounts allowed to log in. Each account's "scope" is
# either "all" (sees every center) or an exact Center Name string from
# the "Payment terms" sheet's Center Name column (sees only that
# center's invoices). "passwordHash" is sha256(password) in hex — never
# the plaintext password. To add/rotate an account, compute the hash
# with:
#   node -e "console.log(require('crypto').createHash('sha256').update('the-password').digest('hex'))"
#
# Example:
# DASHBOARD_USERS=[{"email":"admin@isaac-wellness.com","scope":"all","passwordHash":"<sha256 hex>"},{"email":"greaterkailash@isaac-wellness.com","scope":"Greater Kailash, New Delhi","passwordHash":"<sha256 hex>"}]
DASHBOARD_USERS=
